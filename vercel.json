{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/demo/(.*)", "destination": "/demo/$1" },
    { "source": "/template/(.*)", "destination": "/template/$1" },
    { "source": "/((?!demo/|template/|assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
